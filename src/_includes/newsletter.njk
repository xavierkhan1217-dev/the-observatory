<section class="newsletter">
  <div class="newsletter__inner">
    <div>
      <h2 class="newsletter__title">Stay informed.</h2>
      <p class="newsletter__desc">
        Our latest analysis on economics, markets, politics and ideas, delivered periodically.
      </p>
    </div>
    <form class="newsletter__form" name="newsletter" method="post" data-netlify="true">
      <label class="visually-hidden" for="newsletter-email">Your email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="Your email address"
        autocomplete="email"
      />
      <button class="btn" type="submit">Subscribe</button>
    </form>
  </div>
</section>
