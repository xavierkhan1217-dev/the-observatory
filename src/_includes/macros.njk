{% macro avatar(person, size = "") %}
  {% if person.photo %}
    <img
      class="person__avatar person__avatar--photo {{ 'person__avatar--lg' if size == 'lg' }}"
      src="{{ person.photo }}"
      alt="{{ person.name }}"
      loading="lazy"
    />
  {% else %}
    <div class="person__avatar {{ 'person__avatar--lg' if size == 'lg' }}" aria-hidden="true">
      {{ person.name | first }}
    </div>
  {% endif %}
{% endmacro %}

{% macro socialLinks(person) %}
  {% if person.linkedin %}
    <p class="person__links">
      <a class="textlink" href="{{ person.linkedin }}" rel="me noopener" target="_blank">
        LinkedIn →
      </a>
    </p>
  {% endif %}
{% endmacro %}

{# Square drawing shown beside a headline. Only rendered when the article sets `image`. #}
{% macro art(src, className) %}
  <div class="art {{ className }}">
    <img src="{{ src }}" alt="" width="600" height="600" loading="lazy" decoding="async" />
  </div>
{% endmacro %}

{% macro articleCard(post, size = "default") %}
  {% set cat = post.data.category | category %}
  {% set writer = post.data.author | author %}
  <article class="card card--{{ size }}{{ ' card--has-art' if post.data.image }} reveal">
    <a class="card__link" href="{{ post.url }}">
      <div class="card__body">
        <p class="label">{{ cat.name }}{% if post.data.subcategory %} · {{ post.data.subcategory }}{% endif %}</p>
        <h3 class="card__title">{{ post.data.title }}</h3>
        {% if post.data.subtitle %}
          <p class="card__subtitle">{{ post.data.subtitle }}</p>
        {% endif %}
        <p class="meta">
          <span class="meta__author">{{ writer.name if writer else post.data.author }}</span>
          <span class="meta__dot">·</span>
          {{ post.templateContent | readingTime }} min read
          <span class="meta__dot">·</span>
          {{ post.date | readableDate }}
        </p>
      </div>
      {% if post.data.image %}{{ art(post.data.image, "card__art") }}{% endif %}
    </a>
  </article>
{% endmacro %}

{% macro articleRow(post) %}
  {% set cat = post.data.category | category %}
  {% set writer = post.data.author | author %}
  <article
    class="row{{ ' row--has-art' if post.data.image }} reveal"
    data-category="{{ post.data.category }}"
    data-search="{{ post.data.title }} {{ post.data.subtitle }} {{ writer.name if writer else post.data.author }} {{ cat.name }} {{ post.data.subcategory }} {{ post.data.topics | join(' ') if post.data.topics }}"
  >
    <a class="row__link" href="{{ post.url }}">
      <div class="row__body">
        <p class="label">{{ cat.name }}{% if post.data.subcategory %} · {{ post.data.subcategory }}{% endif %}</p>
        <h3 class="row__title">{{ post.data.title }}</h3>
        {% if post.data.subtitle %}
          <p class="row__subtitle">{{ post.data.subtitle }}</p>
        {% endif %}
        <p class="meta">
          <span class="meta__author">{{ writer.name if writer else post.data.author }}</span>
          <span class="meta__dot">·</span>
          {{ post.templateContent | readingTime }} min read
          <span class="meta__dot">·</span>
          {{ post.date | readableDate }}
        </p>
      </div>
      {% if post.data.image %}{{ art(post.data.image, "row__art") }}{% endif %}
    </a>
  </article>
{% endmacro %}
