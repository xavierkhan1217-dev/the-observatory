---
layout: base.njk
---

{% from "macros.njk" import articleCard with context %}
{% set cat = category | category %}
{% set writer = author | author %}

<article class="article article--rail">
  {# Left rail on wide screens: reading progress, filled by site.js. #}
  <aside class="article__rail" aria-hidden="true">
    <div class="progress-ring" data-progress>
      <svg viewBox="0 0 40 40">
        <circle class="progress-ring__track" cx="20" cy="20" r="17" />
        <circle class="progress-ring__value" cx="20" cy="20" r="17" pathLength="100" />
      </svg>
    </div>
  </aside>

  <div class="article__main">
    <header class="article__head{{ ' article__head--art' if image }}">
      <div class="article__intro">
        <div>
          <a class="label label--link" href="/{{ cat.slug }}/">{{ cat.name }}</a>
          {% if subcategory %}<span class="label label--muted">{{ subcategory }}</span>{% endif %}

          <h1 class="article__title">{{ title }}</h1>
          {% if subtitle %}<p class="article__subtitle">{{ subtitle }}</p>{% endif %}
        </div>

        {% if image %}
          <div class="art article__art">
            <img src="{{ image }}" alt="{{ imageAlt or '' }}" width="600" height="600" decoding="async" />
          </div>
        {% endif %}
      </div>

      <div class="article__meta">
        <div>
          <p class="article__author">
            {% if writer %}
              <a href="/contributors/{{ writer.slug }}/">{{ writer.name }}</a>
            {% else %}
              {{ author }}
            {% endif %}
          </p>
          {% if writer and writer.degree %}
            <p class="article__author-sub">{{ writer.degree }}, {{ writer.university }}</p>
          {% endif %}
        </div>
        <p class="meta">
          Published <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
          <span class="meta__dot">·</span>
          {{ content | readingTime }} min read
        </p>
      </div>
    </header>

    <div class="prose">{{ content | safe }}</div>

    {% if references %}
      <section class="references">
        <h2 class="section-title">References</h2>
        <ol>
          {% for reference in references %}
            <li>{{ reference | safe }}</li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if topics %}
      <ul class="tags">
        {% for topic in topics %}
          <li>{{ topic }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if cat.disclaimer %}
      <p class="disclaimer">
        This article is educational and editorial analysis. It does not constitute financial advice.
      </p>
    {% endif %}

    {% if writer %}
      <section class="author-box">
        <h2 class="section-title">About the author</h2>
        <div class="author-box__inner">
          <div>
            <p class="author-box__name">
              <a href="/contributors/{{ writer.slug }}/">{{ writer.name }}</a>
            </p>
            <p class="author-box__sub">
              {{ writer.degree }}{% if writer.year %}, {{ writer.year }}{% endif %} · {{ writer.university }}
            </p>
            <p class="author-box__bio">{{ writer.bio }}</p>
            <a class="textlink" href="/contributors/{{ writer.slug }}/">All articles by {{ writer.name }} →</a>
          </div>
        </div>
      </section>
    {% endif %}
  </div>

  {% if image %}
    {# Wide screens: the drawing fills the open column to the right of the text. #}
    <aside class="art article__art-side">
      <img src="{{ image }}" alt="{{ imageAlt or '' }}" width="600" height="600" decoding="async" />
    </aside>
  {% endif %}
</article>

{% set relatedPosts = collections.articles | related({ url: page.url, data: { category: category } }) %}
{% if relatedPosts.length %}
  <section class="wrap related">
    <h2 class="section-title">Related articles</h2>
    <div class="grid grid--3">
      {% for post in relatedPosts %}
        {{ articleCard(post) }}
      {% endfor %}
    </div>
  </section>
{% endif %}
